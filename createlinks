#!/usr/bin/perl -w

use esmith::Build::CreateLinks qw(:all);
use esmith::Build::Backup qw(:all);

# our event specific for updating with yum without reboot
$event = 'smeserver-crowdsec-update';
#add here the path to your templates needed to expand
#see the /etc/systemd/system-preset/49-koozali.preset should be present for systemd integration on all you yum update event

# Maybe need ths in here as well:
# /etc/dar/DailyBackup.dcf - if backup requested

foreach my $file (qw(
        /etc/systemd/system-preset/49-koozali.preset
        /etc/crowdsec/config.yaml
       /etc/crowdsec/parsers/s02-enrich/whitelists.yaml
))
{
    templates2events( $file, $event );
};
#action needed in case we have a systemd unit
event_link('systemd-default', $event, '10');
event_link('systemd-reload', $event, '50');

#services we might need to restart
event_services($event, 'crowdsec' => 'restart', 'crowdsec-blocklist-mirror.service' => 'restart', 'crowdsec-firewall-bouncer' => 'restart');
